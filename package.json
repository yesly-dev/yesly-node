{
  "name": "@yesly/node",
  "version": "0.2.0",
  "description": "Official Node.js library for the Yesly API",
  "license": "MIT",
  "homepage": "https://yesly.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yesly-dev/yesly-node.git"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "sideEffects": false,
  "scripts": {
    "generate": "node ../yesly-openapi/sdk/generate.mjs node .",
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "test": "npm run build && tsc -p test/tsconfig.json && node --test test/*.test.mjs",
    "prepublishOnly": "npm test"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "typescript": "7.0.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "yesly",
    "agents",
    "conversations",
    "whatsapp",
    "sms",
    "api"
  ]
}
